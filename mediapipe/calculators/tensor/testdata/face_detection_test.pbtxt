input_stream: "image"
output_stream: "rendering"
output_stream: "detections"

node {
  calculator: "ConstantSidePacketCalculator"
  output_side_packet: "PACKET:face_detection_model_path"
  options: {
    [mediapipe.ConstantSidePacketCalculatorOptions.ext]: {
      packet {
        string_value: "mediapipe/modules/face_detection/face_detection_short_range.tflite"
      }
    }
  }
}

# Subgraph that detects faces.
node {
  calculator: "FaceDetectionShortRangeCpu"
  input_stream: "IMAGE:image"
  input_side_packet: "MODEL_PATH:face_detection_model_path"
  output_stream: "DETECTIONS:detections"
}

# Converts the detections to drawing primitives for annotation overlay.
node {
  calculator: "DetectionsToRenderDataCalculator"
  input_stream: "DETECTIONS:detections"
  output_stream: "RENDER_DATA:render_data"
  options: {
    [mediapipe.DetectionsToRenderDataCalculatorOptions.ext] {
      thickness: 4.0
      color { r: 255 g: 0 b: 0 }
    }
  }
}

# Draws annotations and overlays them on top of the input images.
node {
  calculator: "AnnotationOverlayCalculator"
  input_stream: "IMAGE:image"
  input_stream: "render_data"
  output_stream: "IMAGE:rendering"
}
